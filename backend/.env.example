# ==============================================================================
# Eventra Backend Environment Configuration (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# Do NOT commit .env with real secrets to version control.
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/eventra
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
# Set to true when first connecting to an already-populated database (e.g. Aiven) to baseline at V1
FLYWAY_BASELINE_ON_MIGRATE=false

# JWT Security Configuration (minimum 256 bits / 32+ characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_here
JWT_EXPIRATION=86400000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Groq AI Assistant Configuration
# Obtain your key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_CONNECT_TIMEOUT_MS=5000
GROQ_READ_TIMEOUT_MS=20000

